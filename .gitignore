__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.DS_Store
# The checkers' working files: the banned-synonym list and the allow lists are not part of the public text
.public_text_terms
.public_text_allow
.style_allow
.words_allow
